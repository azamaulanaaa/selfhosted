# Shared stack values for the root .env file.
# Wizards must read each value. They must not guess a default value.

# Canonical stack domain. No service may use the lan domain.
STACK_DOMAIN=sh.lan

# Public or LAN IPv4 of this node. Other nodes use it to connect to this node.
PUBLIC_IP=127.0.0.1

# Capability flags. Set a flag to 1 for integrated mode. Keep it at 0 for standalone mode.
CONSUL_ENABLED=0
LITEFS_ENABLED=0
OIDC_ENABLED=0
TLS_ENABLED=0
