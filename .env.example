# Shared stack values for the root .env file.
# Wizards must read each value. They must not guess a default value.

# Canonical stack domain. No service may use the lan domain.
STACK_DOMAIN=sh.lan

# Container runtime identity. Use 0 for rootless nerdctl.
STACK_ROOTLESS=0
STACK_UID=1000
STACK_GID=1000

# Public or LAN IPv4 of this node. Other nodes use it to connect to this node.
PUBLIC_IP=127.0.0.1

# Consul control-plane address. Consul is always required.
# http://consul:8500 runs Consul in this stack. Any other value runs Consul
# outside this stack. A valid value starts with http:// or https://, has a
# host, and has no whitespace.
CONSUL_ADDR=http://consul:8500

# Local Consul cluster settings. The root wizard writes both values.
# CONSUL_JOIN_IPS is an empty value or a comma-separated list of IPv4 addresses.
# CONSUL_BOOTSTRAP_EXPECT is a number from 1 to 99.
CONSUL_JOIN_IPS=
CONSUL_BOOTSTRAP_EXPECT=1

# Capability flags. Set a flag to 1 to enable an optional peer or feature.
LITEFS_ENABLED=0
OIDC_ENABLED=0
TLS_ENABLED=0
