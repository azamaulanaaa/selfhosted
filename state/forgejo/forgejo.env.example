# Example of config/forgejo/forgejo.env.
# Generated by state/forgejo/setup.sh. Copy the shape only; run the wizard to
# write the real file. Never put secret values in this file.
#
# The wizard writes non-secret answers here. Secrets stay in 0600 files under
# config/forgejo/secrets/ and are passed to containers as *_FILE paths.

# Display name for the forge.
FORGEJO_APP_NAME=Forgejo

# OIDC issuer URL. Must start with https://.
FORGEJO_OIDC_ISSUER_URL=https://auth.example.com

# OIDC client ID registered at that issuer.
FORGEJO_OIDC_CLIENT_ID=forgejo

# Name shown for the OIDC provider on the login page.
FORGEJO_OIDC_PROVIDER_NAME=oidc

# true creates accounts for new OIDC users. false requires an existing account.
FORGEJO_OIDC_AUTO_REGISTER=false

# Port used by the peer git push hook on each Forgejo node.
FORGEJO_PEER_GIT_PORT=3000

# Paths to secret files mounted into the container. No secret values here.
FORGEJO_OIDC_CLIENT_SECRET_FILE=/etc/forgejo/secrets/oidc-client-secret
FORGEJO_SECRET_KEY_FILE=/etc/forgejo/secrets/secret-key
