# syntax=docker/dockerfile:1
# LLDAP wrapped with LiteFS.
# LiteFS replicates the SQLite database that LLDAP uses for its data.
# A single node is the LiteFS primary. Only the primary can write the database.
# Leader election uses a Consul lease. The token for the lease is created by
# state/lldap/entrypoint.sh at boot. The admin password is generated by the
# setup wizard in state/lldap/setup.sh.
# This image contains no secrets.

FROM lldap/lldap:v0.6.3

# Install FUSE 3. LiteFS mounts a filesystem through /dev/fuse.
# The version is pinned to the Alpine 3.19 main repository used by this base
# image. ca-certificates is already in the base image and is not repeated.
RUN apk add --no-cache fuse3=3.16.2-r0

# Pin the LiteFS version and one hash per supported architecture.
# Supported platforms are linux/amd64 and linux/arm64. Both hashes below are
# pinned by hand. Upstream does not publish a SHA256SUMS file for the release
# assets, so both hashes were computed from the release assets on 2026-11-16.
# To update them, download each asset from the release page and run
# sha256sum on it, then adjust the values.
# This image builds for linux/amd64 and linux/arm64. Build both platforms at
# once with docker buildx (--platform linux/amd64,linux/arm64), or build one
# platform on a native host of that architecture.
ARG LITEFS_VERSION=0.5.14
# SHA-256 of litefs-v0.5.14-linux-amd64.tar.gz.
ARG LITEFS_SHA256_AMD64=231190010850c57ab43e278a0b521e50a9fc63a7c571d683dd7febd4ab2cdf30
# SHA-256 of litefs-v0.5.14-linux-arm64.tar.gz.
ARG LITEFS_SHA256_ARM64=c783d1b32ede08e03fbdb8c638861c6496f9401df7d8102aac7cac4c61d6a0ec

RUN set -eu; \
    case "$(uname -m)" in \
        x86_64) LITEFS_ARCH=amd64; LITEFS_SHA256="${LITEFS_SHA256_AMD64}" ;; \
        aarch64 | arm64) LITEFS_ARCH=arm64; LITEFS_SHA256="${LITEFS_SHA256_ARM64}" ;; \
        *) echo "error: unsupported architecture: $(uname -m). Supported: linux/amd64, linux/arm64." >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/litefs.tar.gz \
        "https://github.com/superfly/litefs/releases/download/v${LITEFS_VERSION}/litefs-v${LITEFS_VERSION}-linux-${LITEFS_ARCH}.tar.gz"; \
    printf '%s  %s\n' "${LITEFS_SHA256}" /tmp/litefs.tar.gz > /tmp/litefs.sha256; \
    sha256sum -c /tmp/litefs.sha256; \
    tar --no-same-owner -C /usr/local/bin -xzf /tmp/litefs.tar.gz; \
    rm -f /tmp/litefs.tar.gz /tmp/litefs.sha256; \
    litefs version

# Let non-root users access the FUSE mount. LLDAP runs as uid 1000.
# The fuse.allow-other setting in the mount configuration uses this too.
RUN printf 'user_allow_other\n' >>/etc/fuse.conf

# The LLDAP configuration lives outside the LiteFS mount, so it is mounted
# read-only at container start. LLDAP reads it through LLDAP_CONFIG_FILE.
COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh

ENV LLDAP_CONFIG_FILE=/etc/lldap/lldap_config.toml

# The base image healthcheck points at /data/lldap_config.toml, which does not
# exist in this layout. This healthcheck names the mounted config file.
HEALTHCHECK --interval=10s --timeout=3s --start-period=40s --retries=5 \
    CMD ["/app/lldap", "healthcheck", "--config-file", "/etc/lldap/lldap_config.toml"]

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
