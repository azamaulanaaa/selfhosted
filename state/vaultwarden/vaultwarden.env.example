# Example of config/vaultwarden/vaultwarden.env.
# Generated by state/vaultwarden/setup.sh. Copy the shape only. Run the wizard
# to write the real file. Never put secret values in this file.
#
# All configuration secrets are files under config/vaultwarden/secrets/. This
# file holds only non-secret settings and _FILE paths.

# Public Vaultwarden URL. Caddy serves this host in integrated mode.
DOMAIN=https://vaultwarden.example.com

# OIDC. SSO_ONLY disables password login. The master password is still
# required to unlock the vault.
SSO_ENABLED=true
SSO_ONLY=true
SSO_AUTHORITY=https://tinyauth.example.com
SSO_CLIENT_ID=vaultwarden
SSO_CLIENT_SECRET_FILE=/run/secrets/vaultwarden/oidc-client-secret
SSO_SCOPES=email profile
SSO_PKCE=true
SSO_SIGNUPS_ALLOWED=true
SSO_SIGNUPS_MATCH_EMAIL=true
SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=false

# Local password signups stay disabled. SSO is the only login method.
SIGNUPS_ALLOWED=false

# Secure files are disabled. The official image has no S3 support.
# Attachments, file Sends, and text Sends are unavailable.
SENDS_ALLOWED=false
USER_ATTACHMENT_LIMIT=0
ORG_ATTACHMENT_LIMIT=0
USER_SEND_LIMIT=0

# No SMTP. Invites, email verification, and email 2FA are unavailable.
SIGNUPS_VERIFY=false
REQUIRE_DEVICE_EMAIL=false

# Caddy sets X-Real-IP. WebSocket support stays on for the web UI.
ENABLE_WEBSOCKET=true
IP_HEADER=X-Real-IP

# Optional SMTP settings. The wizard writes these non-secret keys when the
# matching VAULTWARDEN_SMTP_* variable is set. The SMTP password is a file.
# SMTP_HOST=<mail host>
# SMTP_FROM=<sender address>
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=<user>

# Optional secret files. The wizard writes each _FILE key only when the file
# exists under config/vaultwarden/secrets/. Set VAULTWARDEN_ADMIN_TOKEN to
# create admin_token. Set VAULTWARDEN_SMTP_PASSWORD to create smtp_password.
# ADMIN_TOKEN_FILE=/run/secrets/vaultwarden/admin_token
# SMTP_PASSWORD_FILE=/run/secrets/vaultwarden/smtp_password
